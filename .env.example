# Pflicht
DATABASE_URL=postgres://argi:argi@localhost:5432/argi
# Oeffentliche Adresse ohne Schrägstrich am Ende (für Links in E-Mails und Stripe)
APP_URL=http://localhost:3100
# Zufallswert, mindestens 32 Zeichen (signiert das Admin-Cookie)
AUTH_SECRET=
# Passwort für /admin
ADMIN_PASSWORD=

# Zahlung. Ohne STRIPE_SECRET_KEY werden Buchungen nur reserviert
# ("bezahlt wird vor Ort"), sonst geht es zu Stripe Checkout (Karte + TWINT).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-Mail. Ohne SMTP_URL werden Mails nur ins Log geschrieben.
# Beispiel: smtps://benutzer:passwort@mail.example.ch:465
SMTP_URL=
MAIL_FROM="Argi <kurse@example.ch>"
# Hierhin gehen Meldungen über neue Buchungen
ADMIN_EMAIL=
